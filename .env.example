# 生产 Compose 只拉取预构建镜像。使用其他镜像仓库时修改此项。
APP_IMAGE=ghcr.io/yeck/celery-web-speak:latest

# 首次启动时创建服务器管理员。数据库中已有用户后不会再次覆盖。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# 使用 `docker run --rm livekit/livekit-server:v1.13.4 generate-keys` 生成。
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# 服务器公网 IPv4，用于向浏览器发布 ICE/TURN 候选地址。
LIVEKIT_NODE_IP=203.0.113.10

# 与浏览器访问地址保持同源，Nginx 会将 /rtc 转发至 LiveKit。
LIVEKIT_PUBLIC_URL=wss://203.0.113.10
TRUSTED_ORIGINS=https://203.0.113.10
VOICE_RECONCILE_INTERVAL=15s

APP_HTTP_PORT=8080
LIVEKIT_HTTP_PORT=7880
TZ=Asia/Shanghai
